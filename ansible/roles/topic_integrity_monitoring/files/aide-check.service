[Unit]
# Inner unit. Retained deliberately and deliberately without a timer: it is
# started only by the wrapper, through `systemctl start --wait`, so that PID 1
# execs the binary and the stock type-transition init_t -> aide_t applies.
#
# Ships no hardening directives on purpose. The check performs a full-system
# read walk; a namespace-restricting profile would hide subtrees from its view
# and silently shrink the monitored surface. Any such directive here is drift.
Description=AIDE file-integrity check (inner unit)
Documentation=man:aide(1) man:aide.conf(5)
ConditionPathExists=/var/lib/aide/aide.db.gz

[Service]
Type=oneshot
ExecStart=/usr/sbin/aide --check
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30min
