[Unit]
# Acceptance step. No timer and no [Install] on purpose: reachable only
# through `integrity-check accept`, which is itself a manual command.
#
# An automatic baseline refresh accepts every change before anyone has looked
# at it, which turns a change detector into a self-confirming one. Its absence
# is the point of this topic.
Description=AIDE baseline refresh (manual acceptance step)
Documentation=man:aide(1)
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/aide --init
# Run only when ExecStart succeeded. The restorecon is not optional: aide
# --init creates the database with the calling process's context, and
# aide_db_t is required.
#
# Note for consumers: ExecMainStatus reflects ExecStart only, never these
# steps. Anything checking this unit must also require Result=success.
ExecStartPost=/usr/bin/mv -f /var/lib/aide/aide.db.new.gz /var/lib/aide/aide.db.gz
ExecStartPost=/usr/sbin/restorecon -Fv /var/lib/aide/aide.db.gz
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30min
