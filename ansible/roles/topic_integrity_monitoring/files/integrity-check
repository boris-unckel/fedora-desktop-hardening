#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# /usr/local/sbin/integrity-check
#
# Aggregated file-integrity check. Replaces a whole-tree AIDE run with four
# checks, only one of which carries a baseline at all:
#
#   1  rpm -Va          Content, mode, owner, group and capabilities of the
#                       package-owned set. NO baseline — the package database
#                       is updated atomically by the transaction that changes
#                       the files.
#   2  Unowned sweep    Files that belong to no package. NO baseline —
#                       computed against the package database on every run.
#                       Catches the class (1) structurally cannot see: a new
#                       unowned binary in a system binary directory.
#   3  AIDE             Hash history of the remainder. The ONLY check with a
#                       baseline, and it now spans a few thousand paths
#                       instead of the whole tree.
#   4  restorecon -nvR  SELinux context drift. Dry-run only. A class (1)
#                       cannot express.
#
# SELinux — a deliberate, bounded trade-off:
#   This script carries bin_t, so PID 1 starts it as unconfined_service_t, and
#   from that domain there are no type-transitions to aide_exec_t, rpm_exec_t
#   or setfiles_exec_t (verify with `sesearch -T -s unconfined_service_t`).
#
#   For AIDE that is unacceptable — aide_t is a documented end-state property.
#   Check 3 therefore does not run here; it runs through
#   `systemctl start --wait aide-check.service`, so PID 1 execs the binary and
#   the stock init_t -> aide_t transition applies.
#
#   rpm -Va and restorecon -n do run unconfined. Both are strictly read-only
#   (restorecon exclusively in dry-run), so the value of rpm_t / setfiles_t
#   for a pure verification pass is small. The same nesting pattern extends to
#   them without redesign if a deployment wants them confined.
#
# TRAP — `systemctl start --wait` does not propagate the inner unit's exit
#   code. Measured: an inner unit exiting 5 produced caller rc=1. The status
#   MUST be read with `systemctl show -p ExecMainStatus`. Consuming the caller
#   rc collapses the AIDE bitmask onto "non-zero" and makes a tool failure
#   (21 = file lock) indistinguishable from a content delta.
#
# Exit status — deliberately NOT the AIDE 1/2/4 bitmask, which describes one
#   tool's three change classes and does not extend to four aggregated checks:
#   0  all four checks clean
#   1  at least one check reports findings
#   2  at least one check failed as a tool
#
# Log: one file per run under the AIDE log directory. That directory choice is
#   deliberate — it carries aide_log_t, the one location the inner aide_t
#   domain may write, and a separate directory would have needed a
#   file-context entry for no gain. The file name carries the package-manager
#   transaction id, which binds the trail to the transaction that triggered it.

set -euo pipefail

# Deterministic and locale-independent. Both reasons are correctness, not
# tidiness:
#   1. `comm` requires identically sorted inputs, and `sort` collates by
#      locale — a comparison built under one locale and run under another
#      silently produces wrong set differences.
#   2. Part of the parsed output is translated: `rpm -Va` reports a localised
#      word for a missing file.
export LC_ALL=C

readonly LOG_DIR="/var/log/aide"
readonly LOG_PREFIX="integrity"
readonly RETENTION_DAYS=90
readonly AIDE_UNIT="aide-check.service"
readonly AIDE_INIT_UNIT="aide-init.service"
readonly AIDE_DB="/var/lib/aide/aide.db.gz"
readonly ACCEPT_DIR="/etc/integrity-check"
readonly ACCEPT_RPM="${ACCEPT_DIR}/accepted-rpm-verify.txt"
readonly ACCEPT_UNOWNED="${ACCEPT_DIR}/accepted-unowned.txt"
readonly ACCEPT_CONTEXT="${ACCEPT_DIR}/accepted-context.txt"
readonly -a SCAN_ROOTS=(/usr /opt /boot /etc)

LOG=""
FINDINGS=0
TOOL_ERRORS=0

# -----------------------------------------------------------------------------
# log_line(text...)
#
# Writes to stdout (journal) and to the log file. The file write happens only
# in this process — no sub-command ever inherits a write descriptor on the log.
# That matters because sub-commands transition into other domains, and a
# descriptor inherited by a transitioned domain is checked against THAT
# domain's write set, not this one's.
# -----------------------------------------------------------------------------
log_line() {
  printf '%s\n' "$*"
  [[ -n "$LOG" ]] && printf '%s\n' "$*" >>"$LOG"
  return 0
}

log_block() {
  printf '%s\n' "$1"
  [[ -n "$LOG" ]] && printf '%s\n' "$1" >>"$LOG"
  return 0
}

# -----------------------------------------------------------------------------
# normalize_paths()
#
# stdin -> stdout. Resolves BOTH path-aliasing classes that otherwise make a
# `find` versus `rpm -qal` comparison wrong:
#   1. merged /usr   /bin,/sbin,/lib,/lib64  ->  /usr/*
#   2. merged sbin   /usr/sbin               ->  /usr/bin
# Skipping (2) alone reported hundreds of compatibility symlinks as findings
# on every run. The failure is silent and plausible: the comparison succeeds,
# the counts look reasonable, the answer is wrong.
# -----------------------------------------------------------------------------
normalize_paths() {
  sed -E -e 's#^/(bin|sbin|lib|lib64)/#/usr/\1/#' -e 's#^/usr/sbin/#/usr/bin/#'
}

# -----------------------------------------------------------------------------
# accepted(file)
#
# Prints an acceptance list sorted, comments and blank lines removed. A missing
# file yields an empty list, so everything counts as a finding.
# -----------------------------------------------------------------------------
accepted() {
  local f="$1"
  [[ -r "$f" ]] || return 0
  grep -vE '^\s*(#|$)' "$f" 2>/dev/null | sort -u
}

# -----------------------------------------------------------------------------
# installed_kernel_versions()
#
# One kernel version per line, in the form that appears in file names under the
# boot directory.
#
# This is the computable expectation the boot-entry check rests on: the
# versioned boot artefacts do have a baseline — the set of installed kernels —
# so they need no maintained path list, for the same reason the package-owned
# set needs no second hash database.
# -----------------------------------------------------------------------------
installed_kernel_versions() {
  rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core 2>/dev/null \
    | grep -E '^[0-9]' | sort -u
}

# -----------------------------------------------------------------------------
# is_kernel_bls_entry(path)
#
# True for a versioned boot-loader entry, that is
# /boot/loader/entries/<machine-id>-<kernel-version>.conf
#
# The unversioned entries (rescue, memory test) deliberately do not qualify:
# they do not rotate, they belong in the acceptance list, and their
# disappearance should be reported.
# -----------------------------------------------------------------------------
is_kernel_bls_entry() {
  [[ "$1" =~ ^/boot/loader/entries/[0-9a-f]+-[0-9]+\.[0-9]+\.[0-9]+-.+\.conf$ ]]
}

# -----------------------------------------------------------------------------
# drop_kernel_bls(stdin -> stdout)
#
# Filters versioned boot-loader entries out of a path list. Applied to BOTH
# sides of the comparison — filtering only one side would turn every kernel
# change into a phantom "expected file disappeared".
# -----------------------------------------------------------------------------
drop_kernel_bls() {
  local line
  while IFS= read -r line; do
    is_kernel_bls_entry "$line" || printf '%s\n' "$line"
  done
}

# -----------------------------------------------------------------------------
# bls_kver(path) — kernel version carried by a boot-loader entry path.
# -----------------------------------------------------------------------------
bls_kver() {
  local base="${1##*/}"
  base="${base%.conf}"
  printf '%s\n' "${base#*-}"
}

# -----------------------------------------------------------------------------
# check_boot_entries()
#
# For versioned boot-loader entries, replaces the list comparison with a
# comparison against the installed kernels. Both directions stay sharp:
#
#   entry for a kernel that is not installed  -> finding
#   installed kernel with no entry            -> finding
#
# Plain rotation — a new kernel arrives, the oldest is retired — no longer
# produces a finding. It was due on every kernel update by construction and
# turned the whole check red without ever implying an action other than
# accepting it.
# -----------------------------------------------------------------------------
check_boot_entries() {
  log_line ""
  log_line "--- Check 2b: boot-loader entries against installed kernels ---"
  local kvers entries e kv orphan=0 missing=0

  kvers="$(installed_kernel_versions)"
  if [[ -z "$kvers" ]]; then
    log_line "  TOOL FAILURE: no installed kernels could be determined"
    TOOL_ERRORS=$((TOOL_ERRORS + 1))
    return 0
  fi

  # An unreadable directory MUST be a tool failure, not a finding. Otherwise a
  # missing read permission reports every installed kernel as lacking an entry
  # — a plausible-looking result that describes nothing but a broken
  # precondition.
  if [[ ! -d /boot/loader/entries || ! -r /boot/loader/entries ]]; then
    log_line "  TOOL FAILURE: /boot/loader/entries not readable"
    TOOL_ERRORS=$((TOOL_ERRORS + 1))
    return 0
  fi
  entries="$(find /boot/loader/entries -maxdepth 1 -name '*.conf' 2>/dev/null \
    | sort -u || true)"
  if [[ -z "$entries" ]]; then
    log_line "  TOOL FAILURE: no boot-loader entries found"
    TOOL_ERRORS=$((TOOL_ERRORS + 1))
    return 0
  fi

  while IFS= read -r e; do
    [[ -n "$e" ]] || continue
    is_kernel_bls_entry "$e" || continue
    kv="$(bls_kver "$e")"
    if ! printf '%s\n' "$kvers" | grep -qxF "$kv"; then
      log_line "  FINDING: entry for a kernel that is not installed: ${kv}"
      log_line "    ${e}"
      orphan=$((orphan + 1))
    fi
  done <<<"$entries"

  while IFS= read -r kv; do
    [[ -n "$kv" ]] || continue
    if ! printf '%s\n' "$entries" | grep -q -- "-${kv}\.conf$"; then
      log_line "  FINDING: installed kernel with no boot entry: ${kv}"
      missing=$((missing + 1))
    fi
  done <<<"$kvers"

  FINDINGS=$((FINDINGS + orphan + missing))
  if [[ "$orphan" -eq 0 && "$missing" -eq 0 ]]; then
    log_line "  ok -- $(printf '%s\n' "$kvers" | grep -c .) kernels, entries consistent"
  fi
}

# -----------------------------------------------------------------------------
# transaction_id()
#
# Last package-manager transaction id, so the trail is bound to the
# transaction that triggered the run. NONE when not determinable.
# -----------------------------------------------------------------------------
transaction_id() {
  local id
  id="$(dnf history list --reverse 2>/dev/null \
    | awk '$1 ~ /^[0-9]+$/ { id = $1 } END { print id }')" || true
  printf '%s\n' "${id:-NONE}"
}

# -----------------------------------------------------------------------------
# check_rpm_verify()
#
# Ghost entries (file-type marker `g` in the second column) are filtered: the
# package manager declares them expected-to-differ, so reporting them on every
# run is noise by construction.
# -----------------------------------------------------------------------------
check_rpm_verify() {
  log_line ""
  log_line "--- Check 1: rpm -Va (package-owned set) ---"
  local out rc current new n
  out="$(rpm -Va 2>&1)" && rc=0 || rc=$?

  # rc 0 = no deviation, 1 = deviations found. Anything else is a tool failure
  # and must not pass as "no findings".
  if [[ "$rc" -gt 1 ]]; then
    log_line "  TOOL FAILURE: rpm -Va rc=${rc}"
    log_block "$out"
    TOOL_ERRORS=$((TOOL_ERRORS + 1))
    return 0
  fi

  current="$(printf '%s\n' "$out" | grep -vE '^\S+\s+g\s' | grep -E '\S' | sort -u || true)"
  new="$(comm -23 <(printf '%s\n' "$current" | grep -E '\S' || true) \
                  <(accepted "$ACCEPT_RPM") || true)"
  n="$(printf '%s\n' "$new" | grep -c . || true)"
  if [[ "$n" -eq 0 ]]; then
    log_line "  ok -- no new deviations"
  else
    log_line "  FINDING: ${n} new deviation(s)"
    log_block "$(printf '%s\n' "$new" | sed 's/^/    /')"
    FINDINGS=$((FINDINGS + n))
  fi
}

# -----------------------------------------------------------------------------
# check_unowned()
#
# Reports additions AND removals against the acceptance list. A vanished
# expected path is an event too — in particular the disappearance of an
# acceptance list, which is the direct route to suppressing findings.
# -----------------------------------------------------------------------------
check_unowned() {
  log_line ""
  log_line "--- Check 2: unowned sweep (files no package owns) ---"
  local rpmlist fslist current added removed na nr

  rpmlist="$(rpm -qal 2>/dev/null | normalize_paths | sort -u)"
  if [[ -z "$rpmlist" ]]; then
    log_line "  TOOL FAILURE: rpm -qal produced no output"
    TOOL_ERRORS=$((TOOL_ERRORS + 1))
    return 0
  fi
  fslist="$(find "${SCAN_ROOTS[@]}" -xdev \( -type f -o -type l \) 2>/dev/null \
    | normalize_paths | sort -u)"
  current="$(comm -23 <(printf '%s\n' "$fslist") <(printf '%s\n' "$rpmlist"))"

  # Versioned boot-loader entries out, on BOTH sides. They have a computable
  # baseline in the set of installed kernels and are checked against it by
  # check_boot_entries, instead of against a path list that goes stale on
  # every kernel update.
  added="$(comm -23 <(printf '%s\n' "$current" | grep -E '\S' | drop_kernel_bls || true) \
                    <(accepted "$ACCEPT_UNOWNED" | drop_kernel_bls) || true)"
  removed="$(comm -13 <(printf '%s\n' "$current" | grep -E '\S' | drop_kernel_bls || true) \
                      <(accepted "$ACCEPT_UNOWNED" | drop_kernel_bls) || true)"
  na="$(printf '%s\n' "$added" | grep -c . || true)"
  nr="$(printf '%s\n' "$removed" | grep -c . || true)"

  if [[ "$na" -eq 0 && "$nr" -eq 0 ]]; then
    log_line "  ok -- inventory unchanged"
  fi
  if [[ "$na" -gt 0 ]]; then
    log_line "  FINDING: ${na} new unmanaged file(s)"
    log_block "$(printf '%s\n' "$added" | sed 's/^/    + /')"
    FINDINGS=$((FINDINGS + na))
  fi
  if [[ "$nr" -gt 0 ]]; then
    log_line "  FINDING: ${nr} expected file(s) gone"
    log_block "$(printf '%s\n' "$removed" | sed 's/^/    - /')"
    FINDINGS=$((FINDINGS + nr))
  fi
}

# -----------------------------------------------------------------------------
# aide_report_lines()
#
# The detail report of the inner unit run that just finished.
#
# Selected by InvocationID rather than by a time window: the identifier binds
# the lines to exactly this unit run. A time window would pick up the wrong
# report whenever two runs follow each other closely, and would look entirely
# plausible doing it.
#
# Returns 1 when no report can be obtained, so the caller falls back to the
# bitmask instead of implying completeness it does not have.
# -----------------------------------------------------------------------------
aide_report_lines() {
  local invid
  invid="$(systemctl show -p InvocationID --value "$AIDE_UNIT" 2>/dev/null || true)"
  [[ -n "$invid" ]] || return 1
  journalctl "_SYSTEMD_INVOCATION_ID=${invid}" -o cat --no-pager 2>/dev/null \
    | grep -E '\S' || return 1
}

# -----------------------------------------------------------------------------
# boot_artifact_kver(path)
#
# Kernel version carried by a versioned boot artefact, empty for anything
# else. Covers the kernel image, the initramfs, the symbol map, the build
# configuration, the compressed symbol versions, the integrity digest and the
# boot-loader entry — all of them carry the same version in the name.
# -----------------------------------------------------------------------------
boot_artifact_kver() {
  local path="$1"
  [[ "$path" == /boot/* ]] || return 0
  printf '%s\n' "$path" \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+-[0-9]+\.[a-z0-9]+\.[a-z0-9_]+' \
    | head -1
}

# -----------------------------------------------------------------------------
# classify_aide_findings()
#
# Separates the AIDE entries into expected kernel rotation and remainder.
#
# Why this is needed rather than a narrower scope: the six versioned boot
# artefacts per kernel are ghost entries in the package database. Check 1
# filters ghosts and check 2 sees them as package-owned, which leaves AIDE as
# the ONLY check that watches the kernel image at all. Removing them from its
# scope would be a blind spot, not a reduction in noise. So they stay, and are
# classified instead:
#
#   added   + version installed      -> expected (a new kernel)
#   removed + version NOT installed  -> expected (a retired kernel)
#   anything else                    -> finding
#
# The interesting case therefore stays sharp: a CHANGED kernel image belonging
# to an installed kernel is remainder and is reported.
#
# The log stays short — counts plus the remainder, not the whole report. The
# full text remains in the journal of the inner unit.
# -----------------------------------------------------------------------------
classify_aide_findings() {
  local report kvers pairs section path kv
  local n_expected=0 n_rest=0
  local rest=""

  if ! report="$(aide_report_lines)"; then
    log_line "  FINDING: detail report unreadable -- bitmask only."
    log_line "    journalctl -u ${AIDE_UNIT} -b 0"
    FINDINGS=$((FINDINGS + 1))
    return 0
  fi

  kvers="$(installed_kernel_versions)"

  # Two independent filters, both required:
  #
  #   1. Section state. After the detailed-changes heading each changed object
  #      is repeated as a "File:" or "Directory:" line; without a reset every
  #      changed entry is counted a second time.
  #   2. Line shape. Entry lines start with the type character and the flag
  #      column, all lower case. The detail headings start with a capital and
  #      fall out on that alone.
  #
  # The path is taken after the LAST ": " because the flag column of a changed
  # entry contains colons itself.
  pairs="$(printf '%s\n' "$report" | awk '
    /^Added entries:/                      { s = "added";   next }
    /^Removed entries:/                    { s = "removed"; next }
    /^Changed entries:/                    { s = "changed"; next }
    /^Detailed information about changes:/ { s = "";        next }
    /^The attributes of the/               { s = "";        next }
    /^-----/                               { next }
    s != "" && /^[fdlpscb][^:]*: \// {
      line = $0
      sub(/^.*: \//, "/", line)
      print s "\t" line
    }
  ')"

  if [[ -z "$pairs" ]]; then
    log_line "  FINDING: report read, but no entries recognised."
    log_line "    Format change? journalctl -u ${AIDE_UNIT} -b 0"
    FINDINGS=$((FINDINGS + 1))
    return 0
  fi

  while IFS=$'\t' read -r section path; do
    [[ -n "$path" ]] || continue
    kv="$(boot_artifact_kver "$path")"
    if [[ -n "$kv" ]]; then
      if [[ "$section" == "added" ]] \
        && printf '%s\n' "$kvers" | grep -qxF "$kv"; then
        n_expected=$((n_expected + 1))
        continue
      fi
      if [[ "$section" == "removed" ]] \
        && ! printf '%s\n' "$kvers" | grep -qxF "$kv"; then
        n_expected=$((n_expected + 1))
        continue
      fi
    fi
    n_rest=$((n_rest + 1))
    rest+="    ${section}: ${path}"$'\n'
  done <<<"$pairs"

  log_line "  entries: $(printf '%s\n' "$pairs" | grep -c .)" \
    "-- ${n_expected} kernel rotation (expected), ${n_rest} remainder"

  if [[ "$n_rest" -eq 0 ]]; then
    log_line "  ok -- kernel rotation only"
    return 0
  fi

  log_line "  FINDING: ${n_rest} entry/entries outside the kernel rotation"
  # Capped, but the cap is stated. A silent truncation reads as completeness.
  if [[ "$n_rest" -gt 40 ]]; then
    log_block "$(printf '%s' "$rest" | head -40)"
    log_line "    ... $(( n_rest - 40 )) more not shown."
    log_line "    Full text: journalctl -u ${AIDE_UNIT} -b 0"
  else
    log_block "$(printf '%s' "$rest")"
  fi
  FINDINGS=$((FINDINGS + n_rest))
}

# -----------------------------------------------------------------------------
# check_aide()
#
# Through the inner unit so PID 1 execs and init_t -> aide_t applies.
# Status via ExecMainStatus, never via the caller rc — see header.
# -----------------------------------------------------------------------------
check_aide() {
  log_line ""
  log_line "--- Check 3: AIDE (hash baseline of the unmanaged remainder) ---"

  # The inner unit carries ConditionPathExists on the database. Without it the
  # unit is SKIPPED rather than failed, and ExecMainStatus would still hold the
  # value of the PREVIOUS run — reporting a stale status as the current result.
  if [[ ! -f "$AIDE_DB" ]]; then
    log_line "  TOOL FAILURE: ${AIDE_DB} missing -- baseline never taken?"
    log_line "    Create it with: /usr/local/sbin/integrity-check accept"
    TOOL_ERRORS=$((TOOL_ERRORS + 1))
    return 0
  fi

  systemctl reset-failed "$AIDE_UNIT" 2>/dev/null || true
  systemctl start --wait "$AIDE_UNIT" 2>/dev/null || true

  local status
  status="$(systemctl show -p ExecMainStatus --value "$AIDE_UNIT" 2>/dev/null || true)"
  log_line "  ExecMainStatus=${status:-<empty>}"

  case "${status:-}" in
    0)
      log_line "  ok -- no change"
      ;;
    [1-7])
      local parts=""
      (( status & 1 )) && parts+="added "
      (( status & 2 )) && parts+="removed "
      (( status & 4 )) && parts+="changed "
      log_line "  bitmask: ${parts% }"
      classify_aide_findings
      ;;
    "")
      log_line "  TOOL FAILURE: no ExecMainStatus readable"
      TOOL_ERRORS=$((TOOL_ERRORS + 1))
      ;;
    *)
      # >= 14 are AIDE tool failures; 21 is the report-file lock error, which
      # is what a concurrent second run produces.
      log_line "  TOOL FAILURE: AIDE exit=${status}$( [[ "$status" == "21" ]] \
        && printf ' (file lock -- a concurrent AIDE run)' )"
      TOOL_ERRORS=$((TOOL_ERRORS + 1))
      ;;
  esac

  # Do not leave the inner unit in a failed state: this run's aggregate status
  # belongs to the outer unit, not to it.
  systemctl reset-failed "$AIDE_UNIT" 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# check_context()
#
# Dry-run only, changes nothing.
# -----------------------------------------------------------------------------
check_context() {
  log_line ""
  log_line "--- Check 4: SELinux context drift (restorecon -nvR) ---"
  local out rc current new n

  out="$(restorecon -nvR "${SCAN_ROOTS[@]}" 2>&1)" && rc=0 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    log_line "  TOOL FAILURE: restorecon rc=${rc}"
    log_block "$out"
    TOOL_ERRORS=$((TOOL_ERRORS + 1))
    return 0
  fi

  # Reduce to the path: the target context can change with a policy update
  # without the drift being a different one.
  current="$(printf '%s\n' "$out" \
    | sed -nE 's#^Would relabel (\S+) from .*#\1#p' | sort -u)"
  new="$(comm -23 <(printf '%s\n' "$current" | grep -E '\S' || true) \
                  <(accepted "$ACCEPT_CONTEXT") || true)"
  n="$(printf '%s\n' "$new" | grep -c . || true)"
  if [[ "$n" -eq 0 ]]; then
    log_line "  ok -- no new context drift"
  else
    log_line "  FINDING: ${n} path(s) with deviating SELinux context"
    log_block "$(printf '%s\n' "$out" | grep -Ff <(printf '%s\n' "$new") | sed 's/^/    /')"
    FINDINGS=$((FINDINGS + n))
  fi
}

# -----------------------------------------------------------------------------
# prune_logs()
#
# Age limit over the set. logrotate is the wrong tool: it rotates per file,
# these are one file per run — `rotate N` counts generations of each single
# file and never deletes anything, and copytruncate leaves a zero-byte
# artefact, which is exactly the shape that hides a broken trail.
# -----------------------------------------------------------------------------
prune_logs() {
  find "$LOG_DIR" -maxdepth 1 -name "${LOG_PREFIX}-*.log" \
    -mtime "+${RETENTION_DAYS}" -delete 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# write_accept_lists()
#
# Writes the package-verification and unowned lists from current state. The
# context list is deliberately NOT touched — context drift is a defect, not an
# inventory, and it disappears by being fixed rather than accepted.
#
# The three acceptance lists enter the unowned list explicitly. They are not
# package-owned and cannot appear in the sweep result that produces them,
# because the sweep runs first. Excluding the acceptance directory from the
# sweep instead would be the wrong fix: listing them keeps their DISAPPEARANCE
# a finding, which is what an operator wants to know when someone removes an
# acceptance list to suppress results.
# -----------------------------------------------------------------------------
write_accept_lists() {
  local ts out rpmlist fslist current
  ts="$(date +%Y%m%d-%H%M%S)"

  log_line "--- accepted-rpm-verify.txt ---"
  out="$(rpm -Va 2>&1)" || true
  current="$(printf '%s\n' "$out" | grep -vE '^\S+\s+g\s' | grep -E '\S' | sort -u || true)"
  {
    printf '# integrity-check: accepted rpm -Va deviations\n'
    printf '# Current state adopted at %s\n' "$ts"
    printf '# Ghost entries (second-column marker g) are already filtered out.\n'
    printf '%s\n' "$current"
  } >"${ACCEPT_RPM}.new"
  mv -f "${ACCEPT_RPM}.new" "$ACCEPT_RPM"
  chmod 0644 "$ACCEPT_RPM"
  chown root:root "$ACCEPT_RPM"
  log_line "  $(printf '%s\n' "$current" | grep -c . || true) line(s) adopted"

  log_line ""
  log_line "--- accepted-unowned.txt ---"
  rpmlist="$(rpm -qal 2>/dev/null | normalize_paths | sort -u)"
  if [[ -z "$rpmlist" ]]; then
    log_line "  FAILURE: rpm -qal produced no output"
    return 1
  fi
  fslist="$(find "${SCAN_ROOTS[@]}" -xdev \( -type f -o -type l \) 2>/dev/null \
    | normalize_paths | sort -u)"
  current="$(comm -23 <(printf '%s\n' "$fslist") <(printf '%s\n' "$rpmlist"))"
  {
    printf '# integrity-check: accepted non-package-owned paths\n'
    printf '# Current state adopted at %s\n' "$ts"
    printf '# The three acceptance lists are included: they are written after\n'
    printf '# the sweep and can therefore never contain themselves.\n'
    {
      printf '%s\n' "$current"
      printf '%s\n%s\n%s\n' "$ACCEPT_RPM" "$ACCEPT_UNOWNED" "$ACCEPT_CONTEXT"
    } | grep -E '\S' | sort -u
  } >"${ACCEPT_UNOWNED}.new"
  mv -f "${ACCEPT_UNOWNED}.new" "$ACCEPT_UNOWNED"
  chmod 0644 "$ACCEPT_UNOWNED"
  chown root:root "$ACCEPT_UNOWNED"
  log_line "  $(grep -cvE '^\s*(#|$)' "$ACCEPT_UNOWNED" || true) path(s) adopted (including the lists themselves)"

  log_line ""
  log_line "--- accepted-context.txt ---"
  log_line "  deliberately NOT refreshed -- context drift is fixed, not accepted."
  log_line "  Add proven false positives there by hand."
  log_line ""
}

# -----------------------------------------------------------------------------
# mode_accept()
#
# Adopts current state as the new reference. Deliberately manual and
# deliberately absent from the timer.
# -----------------------------------------------------------------------------
mode_accept() {
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  LOG="${LOG_DIR}/${LOG_PREFIX}-accept-${ts}.log"
  mkdir -p "$ACCEPT_DIR" 2>/dev/null || true
  open_log accept || return 2

  log_line "integrity-check accept -- ${ts}"
  log_line ""

  # ORDER IS LOAD-BEARING: write the acceptance lists first, refresh the hash
  # baseline second. The reverse leaves the freshly written lists outside the
  # baseline, so the very next check reports them as changed — a phantom
  # finding no review can resolve, because every acceptance run recreates it.
  write_accept_lists || return 2

  log_line "--- AIDE baseline (after the lists, see above) ---"
  systemctl reset-failed "$AIDE_INIT_UNIT" 2>/dev/null || true
  systemctl start --wait "$AIDE_INIT_UNIT" 2>/dev/null || true

  # ExecMainStatus reflects ExecStart only. The two ExecStartPost steps (moving
  # the new database into place, relabelling it) would stay invisible to it: on
  # failure the OLD database is still there and still non-empty, so a check of
  # ExecMainStatus plus a non-empty test would report success on a refresh that
  # never happened. Result covers the whole unit.
  local status result
  status="$(systemctl show -p ExecMainStatus --value "$AIDE_INIT_UNIT" 2>/dev/null || true)"
  result="$(systemctl show -p Result --value "$AIDE_INIT_UNIT" 2>/dev/null || true)"
  log_line "  ExecMainStatus=${status:-<empty>}  Result=${result:-<empty>}"
  if [[ "$status" != "0" || "$result" != "success" ]]; then
    log_line "  FAILURE: ${AIDE_INIT_UNIT} did not complete cleanly."
    log_line "  journalctl -u ${AIDE_INIT_UNIT} -b 0"
    return 2
  fi
  # Proof the move step ran: the intermediate file must be gone.
  if [[ -e "/var/lib/aide/aide.db.new.gz" ]]; then
    log_line "  FAILURE: aide.db.new.gz still present -- move step did not run."
    return 2
  fi
  if [[ ! -s "$AIDE_DB" ]]; then
    log_line "  FAILURE: ${AIDE_DB} missing or empty after --init"
    return 2
  fi
  log_line "  ok -- $(stat -c '%s' "$AIDE_DB") bytes, label $(stat -c '%C' "$AIDE_DB")"

  log_line ""
  log_line "=== accept complete ==="
  if [[ ! -s "$LOG" ]]; then
    printf 'integrity-check accept: log %s is empty.\n' "$LOG" >&2
    return 2
  fi
  prune_logs
  return 0
}

mode_check() {
  local ts txid
  ts="$(date +%Y%m%d-%H%M%S)"
  txid="$(transaction_id)"
  LOG="${LOG_DIR}/${LOG_PREFIX}-${ts}-dnf${txid}.log"

  open_log check || return 2

  log_line "integrity-check -- ${ts}"
  log_line "transaction : ${txid}"
  log_line "context     : $(id -Z 2>/dev/null || echo '?')"

  check_rpm_verify
  check_unowned
  check_boot_entries
  check_aide
  check_context

  log_line ""
  log_line "=== result ==="
  log_line "  findings      : ${FINDINGS}"
  log_line "  tool failures : ${TOOL_ERRORS}"

  # Without a written log there is no trail, and a "clean" result would not be
  # demonstrable.
  if [[ ! -s "$LOG" ]]; then
    printf 'integrity-check: log %s is empty -- trail not written.\n' "$LOG" >&2
    return 2
  fi

  prune_logs

  if [[ "$TOOL_ERRORS" -gt 0 ]]; then
    log_line "  -> exit 2 (tool failure)"
    return 2
  fi
  if [[ "$FINDINGS" -gt 0 ]]; then
    log_line "  -> exit 1 (findings)"
    return 1
  fi
  log_line "  -> exit 0 (clean)"
  return 0
}

# -----------------------------------------------------------------------------
# open_log(mode)
#
# Creates the log file — and catches the domain trap first.
#
# The log directory carries the AIDE log type. The timer path runs from PID 1
# and may write there; a manual invocation through plain sudo from a confined
# staff login stays in the sudo domain of that role and may not. Without this
# gate the run ends as a bare shell redirection error with no hint at the
# cause — and the acceptance mode is, by construction, the one invoked by hand.
#
# Returns 2 when the log is not writable; the caller aborts.
# -----------------------------------------------------------------------------
open_log() {
  local mode="$1"
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  # A subshell, not `: >"$LOG" 2>/dev/null`: the shell emits the error for a
  # failing redirection itself, outside the command's own redirection, so it
  # would leak ahead of the diagnosis below.
  if ! ( : >"$LOG" ) 2>/dev/null; then
    {
      printf 'integrity-check: cannot create %s\n' "$LOG"
      printf '\n'
      printf '  %s carries the AIDE log type. Plain sudo from a confined\n' "$LOG_DIR"
      printf '  staff login has no write access there.\n'
      printf '\n'
      printf '  Invoke with a role change:\n'
      printf '    sudo -r sysadm_r -t sysadm_t %s %s\n' "$0" "$mode"
      printf '\n'
      printf '  Current context: %s\n' "$(id -Z 2>/dev/null || echo '?')"
    } >&2
    return 2
  fi
  chmod 0600 "$LOG"
  return 0
}

usage() {
  printf 'Usage: sudo -r sysadm_r -t sysadm_t %s [check|accept]\n' "${0##*/}" >&2
  printf '  check   (default) five checks, log under %s, exit 0/1/2\n' "$LOG_DIR" >&2
  printf '  accept  adopt current state as the new reference -- ONLY after review\n' >&2
  printf '\n' >&2
  printf 'The role change is required: %s carries the AIDE log type, and\n' "$LOG_DIR" >&2
  printf 'plain sudo from a confined staff login has no write access there.\n' >&2
  printf 'The timer path is unaffected -- PID 1 starts the unit itself.\n' >&2
}

main() {
  local mode="${1:-check}"
  case "$mode" in
    check)  mode_check ;;
    accept) mode_accept ;;
    *)      usage; return 2 ;;
  esac
}

main "$@"
